# ===== 應用程式基本設定 =====
PORT=3000
NODE_ENV=production
# SQLite 資料庫檔案路徑。部署到 Railway 等雲端主機時，務必指到「有掛載 Volume 的
# 持久化路徑」(例如 /data/app.db)，否則每次重新部署會清空所有使用者資料。
# 本機開發不設定的話，預設是 ./data/app.db
DB_PATH=
# 開啟 debug 模式後，/api/debug 會回傳系統狀態、最近錯誤紀錄、外部資料源連線檢測
DEBUG=false
# /api/debug 需要帶入這組 Token 才能存取 (Header: X-Debug-Token)
DEBUG_TOKEN=change-me-to-a-random-string

# Session 加密金鑰，正式上線前務必更換為隨機字串
SESSION_SECRET=change-me-to-a-random-string

# ===== TDX 運輸資料流通服務 (交通部) =====
# 免費申請流程：
# 1. 前往 https://tdx.transportdata.tw 註冊會員並完成 Email 驗證
# 2. 登入後於「會員中心 > 金鑰管理」建立一組 API 金鑰 (可建立最多 3 組)
# 3. 將取得的 Client ID / Client Secret 貼到下面
# 未設定時，交通模組會自動改用範例(DEMO)資料並在畫面上標示「示範資料」
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# ===== 機票即時比價 (需自行申請商業帳號，目前無免費且完整的方案) =====
# 例如 Amadeus for Developers (https://developers.amadeus.com) 或其他 GDS/OTA 合作夥伴 API
# 未設定時，機票/旅宿比價會顯示為示範資料；「各家深連結」功能不需要這組設定就能用
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=
FLIGHT_API_SECRET=

# ===== AI 助理 (Anthropic Claude API) =====
# 1. 前往 https://console.anthropic.com 註冊帳號並建立 API Key (採用量計費)
# 2. 貼到下面；未設定時，AI 助理頁籤會顯示清楚的設定教學而不是報錯
ANTHROPIC_API_KEY=
# 可選：指定要使用的模型，預設用 claude-3-5-haiku (速度快、成本低，適合日常聊天)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
